# Copy to .env (gitignored) and fill in. Without a key the service runs in mock mode.
GEMINI_API_KEY=your-gemini-api-key-here
# live | mock. "live" silently degrades to "mock" when GEMINI_API_KEY is empty.
LLM_MODE=live
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_THINKING_LEVEL=minimal
LLM_TIMEOUT_S=15
LLM_MAX_RETRIES=2
LLM_MIN_CONFIDENCE=0.7
LLM_CACHE_ENABLED=true
# Optional overrides
# DATA_DIR=./data
# VAR_DIR=./var
# CORS_ORIGINS=http://localhost:3417,http://127.0.0.1:3417
