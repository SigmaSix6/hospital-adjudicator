# Copy to .env (gitignored) and fill in. Without GEMINI_API_KEY the service runs in mock mode.
GEMINI_API_KEY=your-gemini-api-key-here
# live | mock. "live" silently degrades to "mock" when GEMINI_API_KEY is empty.
LLM_MODE=live
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_THINKING_LEVEL=minimal
LLM_TIMEOUT_S=10
LLM_MAX_RETRIES=3
LLM_MIN_CONFIDENCE=0.7
LLM_CACHE_ENABLED=true

# Shared secret for live LLM, batch, and (when set) other protected API routes.
# Pass as X-API-Key (curl/eval) or set the same value for the UI proxy.
# Live reviews over HTTP are rejected until this is set.
REVIEW_API_KEY=change-me-local-dev
# Opt-in: allow POST /reviews/batch with llm_mode=live (default off).
ALLOW_LIVE_BATCH=false
# Hard ceiling on live Gemini spend for the current UTC day (from llm_calls.jsonl).
LLM_DAILY_BUDGET_USD=1.0
LLM_MAX_CONCURRENT_LIVE=2
LLM_LIVE_PER_MINUTE=5
LLM_LIVE_PER_HOUR=30

# Optional overrides
# DATA_DIR=./data
# VAR_DIR=./var
# CORS_ORIGINS=http://localhost:3417,http://127.0.0.1:3417
